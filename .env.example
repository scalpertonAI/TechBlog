# Site Configuration
SITE_URL=http://localhost:3000
NODE_ENV=development

# Newsletter (Beehiiv)
BEEHIIV_API_KEY=your_beehiiv_api_key_here
BEEHIIV_PUBLICATION_ID=your_publication_id_here

# Search (Meilisearch)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=your_meilisearch_master_key_here
NEXT_PUBLIC_MEILI_HOST=http://localhost:7700
NEXT_PUBLIC_MEILI_SEARCH_KEY=your_meilisearch_search_key_here

# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# Error Monitoring (Sentry)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ORG=your_org
SENTRY_PROJECT=your_project
SENTRY_AUTH_TOKEN=your_auth_token

# Image Optimization
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
IMGIX_BASE_URL=https://your-source.imgix.net

# Security
REINDEX_SECRET=your_random_secret_for_reindex_endpoint

# Optional: ISR Revalidation Time (seconds)
REVALIDATE_TIME=60
